{
	"name": "pi-jev-guard",
	"version": "0.1.0",
	"description": "Pi extension: classify every tool call with TypeSafe's Jev model (allow / ask / deny) in ~300 ms, so the main model never spends tokens judging its own tool calls.",
	"keywords": [
		"pi-package",
		"typesafe",
		"jev",
		"guard",
		"permissions"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"lint": "oxlint --type-aware",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && npm run lint && npm run format:check"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@oxlint/plugins": "1.78.0",
		"@types/node": "^24.0.0",
		"oxlint": "1.78.0",
		"oxlint-tsgolint": "7.0.2001",
		"prettier": "3.9.6",
		"typescript": "^5.9.0"
	}
}
